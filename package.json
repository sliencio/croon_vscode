{
  "name": "croon-vscode",
  "displayName": "Croon",
  "description": "在 VS Code 中浏览 Croon 书库、听书并同步收听进度。",
  "version": "0.2.0",
  "publisher": "sliencio",
  "icon": "media/croon-icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./src/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sliencio/croon_vscode.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "croon",
          "title": "Croon",
          "icon": "media/croon-activity.svg"
        }
      ]
    },
    "views": {
      "croon": [
        {
          "id": "croon.sidebar",
          "type": "webview",
          "name": "Croon",
          "icon": "media/croon-activity.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "croon.signIn", "when": "view == croon.sidebar" },
        { "command": "croon.signOut", "when": "view == croon.sidebar" }
      ]
    },
    "commands": [
      {
        "command": "croon.browse",
        "title": "Croon: 浏览书库"
      },
      {
        "command": "croon.recent",
        "title": "Croon: 继续收听"
      },
      {
        "command": "croon.player",
        "title": "Croon: 打开播放器"
      },
      {
        "command": "croon.signIn",
        "title": "Croon: 登录或切换账号"
      },
      {
        "command": "croon.signOut",
        "title": "Croon: 退出登录"
      }
    ]
  },
  "scripts": {
    "check": "node --check src/api.js && node --check src/audio-proxy.js && node --check src/extension.js && node --check src/player.js && node --check media/player.js",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
